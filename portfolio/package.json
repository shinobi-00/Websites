{
  "name": "vishal-raj-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio site. Content in profile.js, rendering in app.js, styles compiled by Tailwind.",
  "scripts": {
    "build": "tailwindcss -i src/input.css -o assets/styles.css --minify && cp node_modules/lucide/dist/umd/lucide.min.js assets/vendor/lucide.min.js",
    "watch": "tailwindcss -i src/input.css -o assets/styles.css --watch",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "lucide": "0.460.0"
  }
}
